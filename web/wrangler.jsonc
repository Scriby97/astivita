// Cloudflare Workers (statische Seite): liefert den Ordner out/ aus, ohne eigenen Code.
// Build-Befehl in Cloudflare: npm run build (Ordner web/), Umgebungsvariablen siehe .env.example.
{
  "name": "astivita",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    // /angebot → angebot.html
    "html_handling": "auto-trailing-slash",
    // unbekannte Adressen → out/404.html
    "not_found_handling": "404-page"
  }
}
