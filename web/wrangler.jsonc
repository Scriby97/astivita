// Cloudflare Worker: liefert den Ordner out/ aus und meldet fehlgeschlagene Builds per ntfy (worker/).
// Build-Befehl in Cloudflare: npm run build (Ordner web/), Umgebungsvariablen siehe .env.example.
{
  "name": "astivita",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /angebot → angebot.html
    "html_handling": "auto-trailing-slash",
    // unbekannte Adressen → out/404.html
    "not_found_handling": "404-page"
  },
  // Build-Ereignisse (Event Subscription im Dashboard) → worker/build-notify.ts
  "queues": { "consumers": [{ "queue": "astivita-builds", "max_batch_size": 10, "max_batch_timeout": 5 }] }
}
